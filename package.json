{
  "name": "goodttv",
  "version": "0.1.0",
  "description": "Cliente de Twitch para la tele, manejado con un mando: directos, seguidos y chat con emotes de 7TV, BTTV y FFZ",
  "author": {
    "name": "Mateo Zariquiey",
    "url": "https://github.com/mateozariquiey"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.20.0"
  },
  "desktopName": "io.github.mateozariquiey.GoodTTV.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build",
    "pack": "bun run build && electron-builder --dir --publish never",
    "package:appimage": "bun run build && electron-builder --linux AppImage --x64 --publish never",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "ky": "2.1.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "build": {
    "afterPack": "./scripts/after-pack.cjs",
    "appId": "io.github.mateozariquiey.GoodTTV",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "productName": "GoodTTV",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/certs",
        "to": "certs"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Video",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "synopsis": "Twitch en la tele con un mando",
      "desktop": {
        "entry": {
          "Name": "GoodTTV",
          "Comment": "Directos de Twitch y chat con un mando",
          "Categories": "AudioVideo;Video;",
          "Keywords": "Twitch;directos;HTPC;TV;"
        }
      },
      "executableArgs": [
        "--fullscreen"
      ]
    },
    "appImage": {
      "compression": "zstd"
    }
  },
  "contributors": [
    {
      "name": "Eliott Bouhana (VacuumStream)",
      "url": "https://github.com/eliottness"
    }
  ],
  "homepage": "https://github.com/mateozariquiey/GoodTTV",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateozariquiey/GoodTTV.git"
  },
  "bugs": {
    "url": "https://github.com/mateozariquiey/GoodTTV/issues"
  }
}
