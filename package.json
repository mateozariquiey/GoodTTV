{
  "name": "goodttv",
  "private": true,
  "description": "GoodTTV: Twitch sin anuncios en la tele, en el navegador y, más adelante, en Android",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "build": "bun run --cwd apps/tele build",
    "build:navegador": "bun run --cwd apps/navegador build",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build && bun run build:navegador",
    "dev": "bun run --cwd apps/tele dev",
    "start": "bun run --cwd apps/tele start",
    "pack": "bun run --cwd apps/tele pack",
    "pack:navegador": "bun run build:navegador && bun run --cwd apps/navegador pack",
    "package:appimage": "bun run --cwd apps/tele package:appimage",
    "test:e2e": "bun run --cwd apps/tele test:e2e",
    "test:humo": "bun run --cwd apps/navegador test:humo",
    "test:interfaz": "bun run --cwd apps/navegador test:interfaz",
    "test:modos": "bun run --cwd apps/navegador test:modos"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
