<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de la app va a las copias en la nube ni pasa a otro teléfono: la sesión de Twitch está cifrada con una clave
     del Keystore que no sale de este (Sesion.kt), y lo demás (preferencias, recientes, Inicio) se rehace solo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
