{
  "name": "@goodttv/navegador",
  "version": "0.2.2",
  "private": true,
  "description": "GoodTTV en el navegador: extensión de Chrome y Firefox con el reproductor propio sin anuncios",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "pack": "node empaquetar.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:humo": "node test/humo/humo.mjs",
    "test:interfaz": "node test/humo/interfaz.mjs",
    "test:modos": "node test/humo/modos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@goodttv/contratos": "workspace:*",
    "@goodttv/interfaz": "workspace:*",
    "@goodttv/servicios": "workspace:*",
    "@goodttv/sin-anuncios": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "hls.js": "^1.7.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "vite": "8.2.2"
  }
}
